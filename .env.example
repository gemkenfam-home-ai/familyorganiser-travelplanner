# Only needed if you run the portal on your own computer with `netlify dev`.
# On the live site these values are stored in Netlify (Site configuration > Environment variables),
# never in a file that gets uploaded. Copy to ".env" for local testing; .env is git-ignored.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=paste-the-anon-public-key-here
SECRET_KEY=a-long-random-string
SECURE_COOKIES=false
